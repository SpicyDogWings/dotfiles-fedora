layout {

    focus-ring {
        active-color   "#67c5e4"
        inactive-color "#1b1f23"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#67c5e4"
        inactive-color "#1b1f23"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#1b1f2370"
    }

    tab-indicator {
        active-color   "#67c5e4"
        inactive-color "#146985"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#67c5e480"
    }
}

recent-windows {
    highlight {
        active-color "#67c5e4"
        urgent-color "#fd4663"
    }
}
