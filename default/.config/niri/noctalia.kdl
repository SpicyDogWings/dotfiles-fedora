layout {

    focus-ring {
        active-color   "#8bb9c1"
        inactive-color "#1c2122"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#8bb9c1"
        inactive-color "#1c2122"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#1c212270"
    }

    tab-indicator {
        active-color   "#8bb9c1"
        inactive-color "#2f616a"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#8bb9c180"
    }
}

recent-windows {
    highlight {
        active-color "#8bb9c1"
        urgent-color "#fd4663"
    }
}
