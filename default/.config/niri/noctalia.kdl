layout {

    focus-ring {
        active-color   "#9ccfdb"
        inactive-color "#111414"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#9ccfdb"
        inactive-color "#111414"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#9ccfdb"
        inactive-color "#376974"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#9ccfdb80"
    }
}

recent-windows {
    highlight {
        active-color "#9ccfdb"
        urgent-color "#ffb4ab"
    }
}
