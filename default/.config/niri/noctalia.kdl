layout {

    focus-ring {
        active-color   "#c3c7cc"
        inactive-color "#131314"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#c3c7cc"
        inactive-color "#131314"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#c3c7cc"
        inactive-color "#111519"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#c3c7cc80"
    }
}

recent-windows {
    highlight {
        active-color "#c3c7cc"
        urgent-color "#ffb4ab"
    }
}
