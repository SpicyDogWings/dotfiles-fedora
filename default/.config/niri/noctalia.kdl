layout {

    focus-ring {
        active-color   "#72daa5"
        inactive-color "#091518"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#72daa5"
        inactive-color "#091518"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#72daa5"
        inactive-color "#005234"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#72daa580"
    }
}

recent-windows {
    highlight {
        active-color "#72daa5"
        urgent-color "#ffb4ab"
    }
}
